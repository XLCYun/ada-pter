{
  "name": "@ada-pter/anthropic",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "test:live": "ANTHROPIC_MODEL=claude-haiku-4-5-20251001 ANTHROPIC_BASE_URL=https://www.dmxapi.cn/v1 bun test --env-file=.env --conditions=development --timeout 100000 tests/anthropic.live.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov && genhtml coverage/lcov.info --output-directory coverage/html --title \"Anthropic Provider Coverage\""
  },
  "dependencies": {
    "ada-pter": "workspace:*",
    "js-tiktoken": "^1.0.21"
  }
}
